<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PS5PayloadSender.PayloadPage"
             Title="إرسال الحمولة"
             BackgroundColor="#0A0A0A">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Padding="16" RowSpacing="12">

            <!-- Developer Info -->
            <Border Grid.Row="0"
                    BackgroundColor="#151515"
                    StrokeShape="RoundRectangle 12"
                    Padding="12"
                    Stroke="#FFD700"
                    StrokeThickness="2">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="&#127986;"
                           FontSize="24"
                           VerticalTextAlignment="Center" />
                    <VerticalStackLayout Spacing="1">
                        <Label Text="Ahlawy-Store"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#FFD700" />
                        <Label Text="&#128222; 01018251103"
                               FontSize="12"
                               TextColor="#B8860B" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- Title -->
            <Label Grid.Row="1"
                   Text="&#9654; إرسال الحمولة (Payload)"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#FFD700" />

            <!-- IP & Port + Connection -->
            <Border Grid.Row="2"
                    BackgroundColor="#151515"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    Stroke="#FFD700"
                    StrokeThickness="1">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="عنوان IP للجهاز" FontSize="13" TextColor="#FFD700" />
                            <Entry x:Name="txtIp"
                                   Text="192.168.1.100"
                                   FontSize="18"
                                   TextColor="#FFD700"
                                   BackgroundColor="#0A0A0A"
                                   HorizontalTextAlignment="Center"
                                   PlaceholderColor="#666" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" WidthRequest="80">
                            <Label Text="المنفذ" FontSize="13" TextColor="#FFD700" HorizontalTextAlignment="Center" />
                            <Entry x:Name="txtPort"
                                   Text="9021"
                                   FontSize="18"
                                   TextColor="#FFD700"
                                   BackgroundColor="#0A0A0A"
                                   HorizontalTextAlignment="Center"
                                   Keyboard="Numeric" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Button Grid.Column="0"
                                x:Name="btnConnect"
                                Text="اتصال"
                                BackgroundColor="#34A853"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                WidthRequest="90"
                                HeightRequest="44"
                                Clicked="OnConnectClicked" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label x:Name="lblConnState"
                                   Text="غير متصل"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#888" />
                            <HorizontalStackLayout Spacing="14">
                                <Label x:Name="lblS9021" Text="&#9679; 9021" FontSize="11" TextColor="#888" />
                                <Label x:Name="lblS2121" Text="&#9679; 2121" FontSize="11" TextColor="#888" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <ActivityIndicator Grid.Column="2"
                                           x:Name="actConn"
                                           IsRunning="False"
                                           IsVisible="False"
                                           Color="#FFD700" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Bundled Payloads -->
            <Border Grid.Row="3"
                    BackgroundColor="#151515"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    Stroke="#FFD700"
                    StrokeThickness="1">
                <VerticalStackLayout Spacing="6">
                    <Label Text="&#128230; الحمولات المدمجة في التطبيق"
                           FontSize="13"
                           TextColor="#FFD700" />
                    <Picker x:Name="pickerBundled"
                            Title="اختر حمولة من القائمة..."
                            BackgroundColor="#0A0A0A"
                            TextColor="#FFD700"
                            TitleColor="#B8860B"
                            SelectedIndexChanged="OnBundledSelected" />
                </VerticalStackLayout>
            </Border>

            <!-- File Picker -->
            <Border Grid.Row="4"
                    BackgroundColor="#151515"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    Stroke="#FFD700"
                    StrokeThickness="1">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="ملف الحمولة المخصصة (Payload File)" FontSize="13" TextColor="#FFD700" />
                        <Label x:Name="lblFileName"
                               Text="لم يتم اختيار ملف"
                               FontSize="14"
                               TextColor="#B8860B"
                               LineBreakMode="TailTruncation" />
                        <Label x:Name="lblFileSize"
                               Text=""
                               FontSize="11"
                               TextColor="#8B6914" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            x:Name="btnBrowse"
                            Text="استعراض"
                            BackgroundColor="#FFD700"
                            TextColor="#0A0A0A"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            WidthRequest="90"
                            HeightRequest="40"
                            Clicked="OnBrowseClicked" />
                </Grid>
            </Border>

            <!-- Send Button -->
            <Button Grid.Row="5"
                    x:Name="btnSend"
                    Text="&#9654; إرسال الحمولة (منفذ 9021)"
                    BackgroundColor="#FFD700"
                    TextColor="#0A0A0A"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="52"
                    Clicked="OnSendClicked" />

            <!-- Log -->
            <Border Grid.Row="6"
                    BackgroundColor="#0D0D0D"
                    StrokeShape="RoundRectangle 12"
                    Padding="12"
                    Stroke="#333"
                    StrokeThickness="1"
                    HeightRequest="280">
                <Grid RowDefinitions="Auto,*">
                    <Label Grid.Row="0"
                           Text="سجل الإرسال (Console Output)"
                           FontSize="13"
                           TextColor="#FFD700"
                           Margin="0,0,0,8" />
                    <CollectionView Grid.Row="1"
                                    x:Name="cvLog"
                                    ItemsLayout="VerticalList"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}"
                                       FontFamily="Courier New"
                                       FontSize="12"
                                       TextColor="#FFD700"
                                       Margin="0,1" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

        </Grid>
    </ScrollView>

</ContentPage>