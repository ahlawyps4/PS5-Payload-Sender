<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PS5PayloadSender.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PS5PayloadSender"
    Title="Ahlawy-Store"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="#0A0A0A"
    Shell.TabBarUnselectedColor="#8B6914"
    Shell.TabBarForegroundColor="#FFD700"
    Shell.BackgroundColor="#0A0A0A"
    Shell.ForegroundColor="#FFD700">

    <TabBar>
        <ShellContent
            Title="إرسال"
            Icon="{OnPlatform Android='tab_sender.png'}"
            ContentTemplate="{DataTemplate local:PayloadPage}"
            Route="PayloadPage" />
        <ShellContent
            Title="FTP"
            Icon="{OnPlatform Android='tab_ftp.png'}"
            ContentTemplate="{DataTemplate local:FtpPage}"
            Route="FtpPage" />
        <ShellContent
            Title="حول"
            Icon="{OnPlatform Android='tab_about.png'}"
            ContentTemplate="{DataTemplate local:AboutPage}"
            Route="AboutPage" />
    </TabBar>

</Shell>
