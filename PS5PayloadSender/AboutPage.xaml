<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PS5PayloadSender.AboutPage"
             Title="حول"
             BackgroundColor="#0A0A0A">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Padding="16" RowSpacing="14">

            <!-- App Identity -->
            <Border Grid.Row="0"
                    BackgroundColor="#151515"
                    StrokeShape="RoundRectangle 20"
                    Padding="20"
                    Stroke="#FFD700"
                    StrokeThickness="2">
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="&#127986;"
                           FontSize="44"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Ahlawy-Store"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#FFD700"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="lblVersion"
                           Text="الإصدار"
                           FontSize="13"
                           TextColor="#B8860B"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Phone -->
            <Border Grid.Row="1"
                    BackgroundColor="#151515"
                    StrokeShape="RoundRectangle 12"
                    Padding="14"
                    Stroke="#333"
                    StrokeThickness="1">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="&#128222;" FontSize="22" VerticalTextAlignment="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="رقم الهاتف" FontSize="12" TextColor="#B8860B" />
                        <Label Text="01018251103" FontSize="16" FontAttributes="Bold" TextColor="#FFD700" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Store -->
            <Button Grid.Row="2"
                    Text="&#128722; متجر Ahlawy-Store"
                    BackgroundColor="#FFD700"
                    TextColor="#0A0A0A"
                    FontSize="15"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnStoreClicked" />

            <!-- Facebook -->
            <Button Grid.Row="3"
                    Text="&#128225; فيسبوك Ahlawy-Store"
                    BackgroundColor="#1877F2"
                    TextColor="White"
                    FontSize="15"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnFacebookClicked" />

            <!-- WhatsApp Catalog -->
            <Button Grid.Row="4"
                    Text="&#128241; كتالوج الألعاب واتساب"
                    BackgroundColor="#25D366"
                    TextColor="White"
                    FontSize="15"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnCatalogClicked" />

            <!-- Footer -->
            <Label Grid.Row="5"
                   Text="جميع الحقوق محفوظة &#169; Ahlawy-Store"
                   FontSize="12"
                   TextColor="#666"
                   HorizontalTextAlignment="Center"
                   Margin="0,10,0,0" />

        </Grid>
    </ScrollView>

</ContentPage>
