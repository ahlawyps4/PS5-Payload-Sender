<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PS5PayloadSender"
             x:Class="PS5PayloadSender.FtpPage"
             Title="متصفح FTP"
             BackgroundColor="#0A0A0A">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Padding="16" RowSpacing="8">

        <!-- Developer Info -->
        <Border Grid.Row="0"
                BackgroundColor="#151515"
                StrokeShape="RoundRectangle 12"
                Padding="10"
                Stroke="#FFD700"
                StrokeThickness="2">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Label Text="&#127986;"
                       FontSize="20"
                       VerticalTextAlignment="Center" />
                <VerticalStackLayout Spacing="1">
                    <Label Text="Ahlawy-Store"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#FFD700" />
                    <Label Text="&#128222; 01018251103"
                           FontSize="11"
                           TextColor="#B8860B" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Border>

        <!-- Title -->
        <Label Grid.Row="1"
               Text="FTP متصفح الملفات"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="#FFD700" />

        <!-- Connection -->
        <Border Grid.Row="2"
                BackgroundColor="#151515"
                StrokeShape="RoundRectangle 12"
                Padding="12"
                Stroke="#FFD700"
                StrokeThickness="1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="IP &amp; المنفذ" FontSize="11" TextColor="#FFD700" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                        <Entry x:Name="txtFtpIp"
                               Text="192.168.1.100"
                               FontSize="14"
                               TextColor="#FFD700"
                               BackgroundColor="#0A0A0A"
                               HorizontalTextAlignment="Center" />
                        <Entry Grid.Column="1"
                               x:Name="txtFtpPort"
                               Text="2121"
                               FontSize="14"
                               TextColor="#FFD700"
                               BackgroundColor="#0A0A0A"
                               HorizontalTextAlignment="Center"
                               Keyboard="Numeric"
                               WidthRequest="55" />
                    </Grid>
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        x:Name="btnConnect"
                        Text="اتصال"
                        BackgroundColor="#FFD700"
                        TextColor="#0A0A0A"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="8"
                        HeightRequest="42"
                        Clicked="OnConnectClicked" />

                <Button Grid.Column="2"
                        x:Name="btnUpload"
                        Text="رفع ملف &#8593;"
                        BackgroundColor="#FFD700"
                        TextColor="#0A0A0A"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="8"
                        HeightRequest="42"
                        IsEnabled="True"
                        Clicked="OnUploadClicked" />

                <Button Grid.Column="3"
                        x:Name="btnUploadFolder"
                        Text="رفع فلدر &#8593;&#8593;"
                        BackgroundColor="#FFD700"
                        TextColor="#0A0A0A"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="8"
                        HeightRequest="42"
                        IsEnabled="True"
                        Clicked="OnUploadFolderClicked" />

                <Button Grid.Column="4"
                        x:Name="btnDownload"
                        Text="تحميل &#8595;"
                        BackgroundColor="#FFD700"
                        TextColor="#0A0A0A"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="8"
                        HeightRequest="42"
                        IsEnabled="True"
                        Clicked="OnDownloadClicked" />
            </Grid>
        </Border>

        <!-- Path -->
        <Border Grid.Row="3"
                BackgroundColor="#151515"
                StrokeShape="RoundRectangle 12"
                Padding="8"
                Stroke="#FFD700"
                StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Button Grid.Column="0"
                        x:Name="btnUp"
                        Text="&#11014;"
                        BackgroundColor="#FFD700"
                        TextColor="#0A0A0A"
                        FontSize="14"
                        CornerRadius="8"
                        WidthRequest="36"
                        HeightRequest="32"
                        IsEnabled="False"
                        Clicked="OnUpClicked" />
                <Entry Grid.Column="1"
                       x:Name="txtPath"
                       Text="/"
                       FontSize="13"
                       TextColor="#FFD700"
                       BackgroundColor="#0A0A0A"
                       HorizontalTextAlignment="Center" />
                <Button Grid.Column="2"
                        x:Name="btnRefresh"
                        Text="&#8635;"
                        BackgroundColor="#FFD700"
                        TextColor="#0A0A0A"
                        FontSize="14"
                        CornerRadius="8"
                        WidthRequest="36"
                        HeightRequest="32"
                        IsEnabled="False"
                        Clicked="OnRefreshClicked" />
            </Grid>
        </Border>

        <!-- File List -->
        <CollectionView Grid.Row="4"
                        x:Name="cvFiles"
                        SelectionMode="Single"
                        SelectionChanged="OnFileSelected"
                        ItemsLayout="VerticalList">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:FtpItem">
                    <Border BackgroundColor="#151515"
                            StrokeShape="RoundRectangle 8"
                            Padding="12"
                            Stroke="#333"
                            StrokeThickness="1"
                            Margin="0,2">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Text="{Binding Icon}"
                                   FontSize="22"
                                   VerticalTextAlignment="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                       FontSize="14"
                                       TextColor="#FFD700"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Info}"
                                       FontSize="11"
                                       TextColor="#B8860B" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{Binding SizeText}"
                                   FontSize="12"
                                   TextColor="#8B6914"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Status Bar -->
        <Border Grid.Row="5"
                BackgroundColor="#151515"
                StrokeShape="RoundRectangle 8"
                Padding="10"
                Stroke="#333"
                StrokeThickness="1">
            <Label x:Name="lblStatus"
                   Text="غير متصل"
                   FontSize="12"
                   TextColor="#B8860B"
                   HorizontalTextAlignment="Center" />
        </Border>

    </Grid>

</ContentPage>